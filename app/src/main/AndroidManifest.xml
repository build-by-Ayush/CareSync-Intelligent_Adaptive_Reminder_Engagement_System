<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WorkManager background tasks -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Internet (for ML model later) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareSync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CareSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receivers.CompleteTaskReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.SnoozeTaskReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.DismissTaskReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.NotificationDeletedReceiver"
            android:exported="false" />

    </application>

</manifest>
